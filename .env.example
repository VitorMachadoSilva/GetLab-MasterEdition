# ============================================
# CONFIGURAÇÃO DO BANCO DE DADOS
# ============================================
# 1. Acesse: https://console.neon.tech/
# 2. Copie sua "Connection String"  
# 3. Cole abaixo (exemplo):
DATABASE_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ============================================
# AUTENTICAÇÃO (NextAuth)
# ============================================
# Gere uma chave secreta executando no terminal:
# openssl rand -base64 32
NEXTAUTH_SECRET="sua-chave-secreta-gerada-aqui"

# URL da aplicação (não mude em desenvolvimento)
NEXTAUTH_URL="http://localhost:3000"

# ============================================
# CREDENCIAIS DO ADMINISTRADOR
# ============================================
# Email e senha para o primeiro acesso admin
ADMIN_EMAIL="admin@fmpsc.edu.br"
ADMIN_PASSWORD="Admin@2024"

# ============================================
# APÓS CONFIGURAR:
# ============================================
# 1. Renomeie este arquivo para: .env
# 2. Execute: npm run db:generate
# 3. Execute: npm run db:push
# 4. Execute: npm run dev
# ============================================
